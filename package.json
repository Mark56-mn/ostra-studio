{
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "bun --filter @ostra/web run dev",
    "dev:api": "bun --filter @ostra/api run dev",
    "dev": "bun run dev:web",
    "build": "bun --filter @ostra/web run build",
    "build:all": "bun --filter @ostra/web run build && bun --filter @ostra/api run build",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "lint": "bun --filter @ostra/web run lint"
  }
}
